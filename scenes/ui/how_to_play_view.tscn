[node name="Body" type="Label" parent="Center/Panel/Column/StepScroll/Steps/Step2"]
layout_mode = 2
autowrap_mode = 3
text = "Hover a card to read what it does, including Blitz and Guard. A bullet is a strike unit, a shield holds the line, and a cross is an Order or Countermeasure. Rust, steel, and gold frames match those marks. The brass coin is deploy cost; the gear is operate cost. The rust spearhead is attack and the steel shield is defense. The gold pip above your hand is current Credit / the turn cap, which grows by 1 each turn."

[node name="Step3" type="VBoxContainer" parent="Center/Panel/Column/StepScroll/Steps"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Heading" type="Label" parent="Center/Panel/Column/StepScroll/Steps/Step3"]
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.82, 0.55, 1)
theme_override_font_sizes/font_size = 16
text = "3  Deploy"

[node name="Body" type="Label" parent="Center/Panel/Column/StepScroll/Steps/Step3"]
layout_mode = 2
autowrap_mode = 3
text = "The first turn has 1 Credit. Click a gold-bordered hand card then a Support slot, or drag it there. A unit deployed this turn cannot act yet, unless it has Blitz."

[node name="Step4" type="VBoxContainer" parent="Center/Panel/Column/StepScroll/Steps"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Heading" type="Label" parent="Center/Panel/Column/StepScroll/Steps/Step4"]
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.82, 0.55, 1)
theme_override_font_sizes/font_size = 16
text = "4  Frontline"

[node name="Body" type="Label" parent="Center/Panel/Column/StepScroll/Steps/Step4"]
layout_mode = 2
autowrap_mode = 3
text = "Infantry and Tanks in Support can only hit the Frontline; from the Frontline they hit Support or HQ. Fighters can strike from Support. Some cards can hit Support, Frontline, or HQ from Support — hover to read. If the enemy holds the Frontline, you cannot enter."

[node name="Step5" type="VBoxContainer" parent="Center/Panel/Column/StepScroll/Steps"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Heading" type="Label" parent="Center/Panel/Column/StepScroll/Steps/Step5"]
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.82, 0.55, 1)
theme_override_font_sizes/font_size = 16
text = "5  Attack and turns"

[node name="Body" type="Label" parent="Center/Panel/Column/StepScroll/Steps/Step5"]
layout_mode = 2
autowrap_mode = 3
text = "Select a ready unit, then a highlighted target. Moving and attacking spend Credit. Each turn starts by drawing 1 and refilling Credit to the cap. Press E to end the turn when nothing else is legal; the cap grows by 1."

[node name="Step6" type="VBoxContainer" parent="Center/Panel/Column/StepScroll/Steps"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Heading" type="Label" parent="Center/Panel/Column/StepScroll/Steps/Step6"]
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.82, 0.55, 1)
theme_override_font_sizes/font_size = 16
text = "6  Orders and Countermeasures"

[node name="Body" type="Label" parent="Center/Panel/Column/StepScroll/Steps/Step6"]
layout_mode = 2
autowrap_mode = 3
text = "Orders play on the turn you spend them. Countermeasures arm in hand first. Press ? during a match to reopen this sheet."

